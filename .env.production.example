# Шаблон .env для production-деплоя.
# На сервере: скопируй в .env и обязательно поправь все значения с пометкой [CHANGE_ME].
#
# Сильные пароли можешь сгенерировать командой:
#   openssl rand -base64 24

# === PostgreSQL ===
POSTGRES_USER=resumehelper
POSTGRES_PASSWORD=__CHANGE_ME__  # сгенерируй через openssl rand -base64 24
POSTGRES_DB=resumehelper

# === MinIO ===
MINIO_ROOT_USER=resumehelper_admin
MINIO_ROOT_PASSWORD=__CHANGE_ME__  # сгенерируй через openssl rand -base64 24
MINIO_BUCKET=portfolio
# Адрес MinIO с точки зрения браузера. На проде — публичный HTTPS-URL,
# который проксирует системный nginx на хосте на порт 9000 контейнера.
MINIO_PUBLIC_ENDPOINT=https://your-domain.duckdns.org/files

# === IO.Net (AI-помощь) ===
# Если ключа нет — поставь AI_MOCK_MODE=true, и приложение отдаст заранее
# заготовленные варианты. Для защиты лучше иметь живой ключ.
IO_NET_API_KEY=__YOUR_NEW_KEY_HERE__  # ключ нужно пересоздать в IO.Net, старый засветился
IO_NET_BASE_URL=https://api.intelligence.io.solutions/api/v1
IO_NET_MODEL=meta-llama/Llama-3.3-70B-Instruct
AI_MOCK_MODE=false

# === CORS ===
# Только публичный HTTPS-домен — без localhost
CORS_ORIGINS=https://your-domain.duckdns.org

# === Окружение ===
ENVIRONMENT=production
